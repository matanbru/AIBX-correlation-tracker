# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Market data (required): free key from https://twelvedata.com
TWELVE_DATA_API_KEY=

# Optional alternative price provider: leave blank to use Twelve Data
FINNHUB_API_KEY=

# SEC EDGAR (no key needed): the SEC requires a real contact email
SEC_USER_AGENT=AI-Stock-Tracker your.email@example.com

# FRED (optional): yields work without a key via the public CSV
FRED_API_KEY=

# Used by the authentication routes
JWT_SECRET=change-me
